# Firetower MCP server — environment configuration (sample; do not commit real values)

# Hop 1: Google OAuth client (Workspace-gated to sentry.io)
MCP_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
MCP_GOOGLE_CLIENT_SECRET=your-client-secret
# Public base URL of the MCP server (same origin serves the OAuth endpoints)
MCP_BASE_URL=https://firetower-mcp.example.com
# Comma-separated allowed client redirect URIs. REQUIRED — the server refuses to
# start if this is empty, because an empty list makes FastMCP fall open and accept
# ANY redirect URI (unacceptable for a confidential-data service). Intended: the
# Claude.ai connector callback + Claude Code's localhost ports. VERIFY the exact
# pattern/wildcard syntax FastMCP expects for allowed_client_redirect_uris before
# relying on the localhost glob.
MCP_ALLOWED_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback,http://localhost:*

# Hop 2: service identity used to read firetower (sees non-private incidents only)
FIRETOWER_SERVICE_ACCOUNT=firetower-mcp@your-project.iam.gserviceaccount.com

# Optional
FIRETOWER_URL=
# Secret used to sign FastMCP JWTs. Set this explicitly in production: if omitted
# it is derived from the client secret, which is fine for one instance but means
# tokens can only be verified by the instance that issued them.
MCP_JWT_SIGNING_KEY=
MCP_HOST=0.0.0.0
PORT=8080

# MULTI-INSTANCE / AUTOSCALING CONSTRAINT
# FastMCP's default client_storage is a per-instance encrypted FILE store. Under
# Cloud Run autoscaling, OAuth state (client registrations + encrypted tokens)
# issued by one instance will NOT resolve on another, causing intermittent auth
# failures (failed token exchanges/refreshes) as requests land on different
# instances. To run more than one instance safely, configure a SHARED client_storage
# backend (e.g. Redis/GCS-backed AsyncKeyValue) and set MCP_JWT_SIGNING_KEY so every
# instance signs/verifies with the same key. Until then, pin the service to a single
# instance (min=max=1).
