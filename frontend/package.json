{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.7.1",
  "type": "module",
  "scripts": {
    "predev": "pnpm run tokens:generate",
    "dev": "vite",
    "type-check": "tsc --project tsconfig.build.json --noEmit",
    "prebuild": "pnpm run tokens:generate",
    "build": "tsc --project tsconfig.build.json --noEmit && vite build",
    "lint": "pnpm run tokens:check && eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "tokens:generate": "node scripts/generate-scraps-theme.mjs",
    "preview": "vite preview",
    "tokens:check": "node scripts/generate-scraps-theme.mjs --check"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@sentry/react": "^10.63.0",
    "@sentry/scraps": "0.1.0",
    "@sentry/vite-plugin": "^5.4.1",
    "@stylexjs/stylex": "^0.19.1",
    "@t3-oss/env-core": "^0.13.8",
    "@tanstack/react-query": "^5.90.12",
    "@tanstack/react-router": "^1.141.1",
    "@tanstack/zod-adapter": "^1.141.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.560.0",
    "react": "^19.2.2",
    "react-day-picker": "^9.13.0",
    "react-dom": "^19.2.2",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@happy-dom/global-registrator": "^20.0.11",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.0",
    "@stylexjs/eslint-plugin": "^0.19.1",
    "@stylexjs/unplugin": "^0.19.1",
    "@tanstack/react-router-devtools": "^1.141.1",
    "@tanstack/router-plugin": "^1.141.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.2.2",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "prettier": "^3.7.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.49.0",
    "unplugin": "^2.3.11",
    "vite": "^7.3.7",
    "vitest": "^4.1.11"
  }
}
